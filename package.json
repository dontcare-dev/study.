{
  "name": "study-desktop",
  "version": "1.0.0",
  "description": "A focused desktop exam revision studio",
  "main": "main.cjs",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "build:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.nyx.study",
    "productName": "Study",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
